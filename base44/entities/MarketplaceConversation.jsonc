{
  "name": "MarketplaceConversation",
  "type": "object",
  "properties": {
    "listing_id": {
      "type": "string",
      "description": "FK\u2192MarketplaceListing. The listing this conversation is about."
    },
    "poster_id": {
      "type": "string",
      "description": "FK\u2192User. The listing's poster (denormalized for queries; mirrors MarketplaceListing.poster_id). NEVER buyer_id/seller_id \u2014 the UI derives Buyer/Seller labels from the listing's listing_type at render time."
    },
    "initiator_id": {
      "type": "string",
      "description": "FK\u2192User. The user who started the conversation (the responder to the listing). Mirrors created_by_id; explicit for the uniqueness key."
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time",
      "description": "Source of truth: MAX(MarketplaceMessage.created_at WHERE conversation_id = this). Used for inbox sort order. Defaults to created_at."
    },
    "poster_archived_at": {
      "type": "string",
      "format": "date-time",
      "description": "Participant-level archive \u2014 hides the conversation from the poster's inbox without affecting the initiator's copy. Reversible (poster clears it to un-archive)."
    },
    "initiator_archived_at": {
      "type": "string",
      "format": "date-time",
      "description": "Participant-level archive for the initiator. Independent of poster_archived_at. Reversible."
    },
    "poster_last_read_at": {
      "type": "string",
      "format": "date-time",
      "description": "Read-tracking pointer for the poster side. Continuously updated, not a lifecycle state. No read_at on Message (ADR-022)."
    },
    "initiator_last_read_at": {
      "type": "string",
      "format": "date-time",
      "description": "Read-tracking pointer for the initiator side. Continuously updated."
    }
  },
  "required": [
    "listing_id",
    "poster_id",
    "initiator_id",
    "last_message_at"
  ]
}