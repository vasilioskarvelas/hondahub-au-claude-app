{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "actor_type": {
      "type": "string",
      "enum": [
        "user",
        "moderator",
        "admin",
        "system"
      ],
      "description": "The kind of actor that performed the action. `system` entries carry actor_id = null."
    },
    "actor_id": {
      "type": "string",
      "description": "FK\u2192User. Null when actor_type = system."
    },
    "action": {
      "type": "string",
      "enum": [
        "vehicle_verification_approved",
        "business_status_changed",
        "listing_removed_by_moderation",
        "trust_tier_overridden",
        "financial_change_approved",
        "report_filed",
        "moderation_action_applied",
        "moderation_case_status_changed",
        "event_cancelled",
        "group_member_removed"
      ],
      "description": "AuditActionType registry \u2014 never a free-text string. Append-only: no update or delete path, ever."
    },
    "target_type": {
      "type": "string",
      "description": "Polymorphic target, validated against ReferenceTypes."
    },
    "target_id": {
      "type": "string"
    },
    "context": {
      "type": "string",
      "description": "Additional structured detail (e.g. old/new value for a status change). Nullable."
    }
  },
  "required": [
    "actor_type",
    "action",
    "target_type",
    "target_id"
  ]
}