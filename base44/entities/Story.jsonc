{
  "name": "Story",
  "type": "object",
  "properties": {
    "author_name": {
      "type": "string"
    },
    "media_url": {
      "type": "string"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "photo",
        "video"
      ],
      "default": "photo"
    },
    "caption": {
      "type": "string"
    },
    "views": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "author_name",
    "media_url",
    "media_type"
  ]
}