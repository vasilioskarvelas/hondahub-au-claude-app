{
  "name": "Notification",
  "type": "object",
  "properties": {
    "recipient_id": {
      "type": "string",
      "description": "FK\u2192User. The user who receives this notification."
    },
    "notification_type": {
      "type": "string",
      "enum": [
        "new_follower",
        "new_comment",
        "new_like",
        "mention",
        "business_tag",
        "event_reminder",
        "moderation_outcome",
        "report_update",
        "trust_tier_change"
      ],
      "description": "Validated against the NotificationType registry. Open to registry-controlled growth \u2014 every value used must be added to the registry first, never accepted as an arbitrary string."
    },
    "actor_id": {
      "type": "string",
      "description": "FK\u2192User, nullable. Who caused it (null for system-generated notifications, e.g. trust_tier_change)."
    },
    "target_type": {
      "type": "string",
      "description": "Polymorphic target type, validated against the ReferenceTypes registry in service code (not a DB enum). Nullable."
    },
    "target_id": {
      "type": "string",
      "description": "Polymorphic target ID. Nullable."
    },
    "read_at": {
      "type": "string",
      "format": "date-time",
      "description": "Null = unread."
    }
  },
  "required": [
    "recipient_id",
    "notification_type"
  ]
}