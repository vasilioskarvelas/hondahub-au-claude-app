{
  "name": "Notification",
  "type": "object",
  "properties": {
    "recipient_id": {
      "type": "string",
      "description": "FK\u2192User. The user who receives this notification."
    },
    "notification_type": {
      "type": "string",
      "enum": [
        "new_follower",
        "new_comment",
        "new_like",
        "mention",
        "business_tag",
        "event_reminder",
        "moderation_outcome",
        "report_update",
        "trust_tier_change",
        "new_marketplace_message",
        "listing_update",
        "new_vehicle_update"
      ],
      "description": "Validated against the NotificationType registry. Open to registry-controlled growth \u2014 every value used must be added to the registry first, never accepted as an arbitrary string."
    },
    "actor_id": {
      "type": "string",
      "description": "FK\u2192User, nullable. Who caused it (null for system-generated notifications, e.g. trust_tier_change)."
    },
    "target_type": {
      "type": "string",
      "description": "Polymorphic target type, validated against the ReferenceTypes registry in service code (not a DB enum). Nullable."
    },
    "target_id": {
      "type": "string",
      "description": "Polymorphic target ID. Nullable."
    },
    "read_at": {
      "type": "string",
      "format": "date-time",
      "description": "Null = unread."
    },
    "delivery_status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "failed",
        "permanently_failed"
      ],
      "default": "sent",
      "description": "Phase 09 delivery lifecycle. In-app notifications are delivered at row creation (createNotification writes 'sent'). 'failed' rows are retried by the NotificationDeliveryRetry workflow; after the 5th failed retry attempt the row is marked 'permanently_failed' and excluded from all future runs (retained for support/debugging, never deleted). 'pending' is reserved for future async external delivery channels (email/push) not yet integrated."
    },
    "retry_count": {
      "type": "number",
      "default": 0,
      "description": "Phase 09: number of failed delivery retries performed for this notification. Incremented on each failed retry attempt; reset to 0 on successful delivery (sent)."
    },
    "last_attempt_at": {
      "type": "string",
      "format": "date-time",
      "description": "Phase 09: timestamp of the most recent delivery attempt. Drives the exponential backoff (1,2,4,8,16 min) for the retry job's due check."
    }
  },
  "required": [
    "recipient_id",
    "notification_type"
  ]
}