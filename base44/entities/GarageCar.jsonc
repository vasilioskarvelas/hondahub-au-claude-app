{
  "name": "GarageCar",
  "type": "object",
  "properties": {
    "model": {
      "type": "string",
      "description": "Legacy garage car model name. Superseded by the Vehicle entity for new data."
    },
    "year": {
      "type": "number"
    },
    "chassis_code": {
      "type": "string"
    },
    "engine_code": {
      "type": "string"
    },
    "engine_family": {
      "type": "string"
    },
    "induction_type": {
      "type": "string",
      "enum": [
        "na",
        "fi"
      ],
      "description": "na = naturally aspirated, fi = forced induction."
    },
    "power_kw": {
      "type": "number"
    },
    "dyno_kw": {
      "type": "number"
    },
    "gearbox": {
      "type": "string"
    },
    "track_time": {
      "type": "string"
    },
    "track_name": {
      "type": "string"
    },
    "time_verified": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "rejected"
      ],
      "default": "pending"
    },
    "drag_time": {
      "type": "string"
    },
    "modifications": {
      "type": "string"
    },
    "future_plans": {
      "type": "string"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "time_slip_url": {
      "type": "string"
    },
    "instagram": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    }
  },
  "required": [
    "model"
  ]
}