{
  "name": "Report",
  "type": "object",
  "properties": {
    "reporter_id": {
      "type": "string",
      "description": "FK\u2192User. The reporter (mirrors created_by_id; explicit for the uniqueness key). Unique on (reporter_id, target_type, target_id) while status=open."
    },
    "target_type": {
      "type": "string",
      "enum": [
        "user",
        "vehicle",
        "post",
        "comment",
        "group",
        "event",
        "business",
        "business_review",
        "listing",
        "marketplace_message"
      ],
      "description": "Reportable subset of ReferenceTypes (DATABASE_SCHEMA \u00a722). REPORT and MODERATION_CASE exist in the platform-wide registry but are NOT reportable targets. business_review added in Phase 07 (\u00a726 BusinessReview is reportable)."
    },
    "target_id": {
      "type": "string",
      "description": "FK\u2192 the backing entity per target_type. Validated via ReferenceResolverService."
    },
    "category": {
      "type": "string",
      "enum": [
        "spam",
        "scam",
        "harassment",
        "hate_speech",
        "illegal",
        "copyright",
        "fake_listing",
        "dangerous_behaviour",
        "other"
      ],
      "description": "Fixed report category enum (\u00a72.1). Reused as-is; no new categories."
    },
    "description": {
      "type": "string",
      "description": "Reporter's optional free-text account of the issue."
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "consolidated",
        "resolved",
        "dismissed"
      ],
      "default": "open",
      "description": "open = newly filed. consolidated = folded into a ModerationCase. resolved = actioned. dismissed = no action."
    },
    "moderation_case_id": {
      "type": "string",
      "description": "FK\u2192ModerationCase. Set when this report is consolidated into a case."
    }
  },
  "required": [
    "reporter_id",
    "target_type",
    "target_id",
    "category"
  ]
}