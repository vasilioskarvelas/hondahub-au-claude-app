{
  "name": "Report",
  "type": "object",
  "properties": {
    "reporter_id": {
      "type": "string",
      "description": "FK\u2192User. The reporter (mirrors created_by_id; explicit for the uniqueness key). Unique on (reporter_id, target_type, target_id) while status=open."
    },
    "target_type": {
      "type": "string",
      "enum": [
        "user",
        "vehicle",
        "post",
        "comment",
        "group",
        "event",
        "business",
        "listing",
        "marketplace_message"
      ],
      "description": "The reported content type. Validated against the Report target subset of ReferenceTypes."
    },
    "target_id": {
      "type": "string",
      "description": "FK\u2192 the backing entity per target_type."
    },
    "reason": {
      "type": "string",
      "description": "Free-text reason from the reporter at MVP."
    },
    "details": {
      "type": "string",
      "description": "Optional additional context from the reporter."
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "consolidated",
        "resolved",
        "dismissed"
      ],
      "default": "open",
      "description": "open = newly filed. consolidated = folded into a ModerationCase. resolved = actioned. dismissed = no action."
    },
    "case_id": {
      "type": "string",
      "description": "FK\u2192ModerationCase. Set when the report is consolidated into a case."
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_by": {
      "type": "string",
      "description": "FK\u2192User (mod/admin who resolved the report)."
    }
  },
  "required": [
    "reporter_id",
    "target_type",
    "target_id",
    "reason"
  ]
}