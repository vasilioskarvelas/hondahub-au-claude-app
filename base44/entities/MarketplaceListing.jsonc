{
  "name": "MarketplaceListing",
  "type": "object",
  "properties": {
    "poster_id": {
      "type": "string",
      "description": "FK\u2192User. The poster (mirrors created_by_id; explicit and load-bearing). On a 'wanted' listing the poster is the BUYER \u2014 never assume poster=seller. UI derives Buyer/Seller labels from listing_type at render time, never from this field name."
    },
    "listing_type": {
      "type": "string",
      "enum": [
        "for_sale",
        "wanted"
      ],
      "default": "for_sale",
      "description": "for_sale: poster is selling. wanted: poster is seeking to buy. Drives all Buyer/Seller role derivation in the UI and event payloads."
    },
    "category": {
      "type": "string",
      "enum": [
        "vehicle",
        "engine",
        "transmission",
        "forced_induction",
        "wheels_tyres",
        "suspension",
        "brakes",
        "electronics",
        "interior",
        "exterior",
        "performance_part",
        "tools_equipment",
        "other"
      ],
      "description": "Listing category. Compatibility fields only apply when category != vehicle. primary_vehicle_id is required when category=vehicle AND listing_type=for_sale."
    },
    "title": {
      "type": "string",
      "description": "Listing title. Required, length-capped, moderation-checked (public-facing)."
    },
    "description": {
      "type": "string",
      "description": "Nullable free-text description."
    },
    "price_type": {
      "type": "string",
      "enum": [
        "fixed",
        "negotiable",
        "poa",
        "free",
        "auction"
      ],
      "default": "fixed",
      "description": "fixed/negotiable require price_cents; poa/free require price_cents = null. auction requires auction_min_bid_cents + auction_duration_days; price_cents is null. Auction creation is gated by the create_auction entitlement (premium subscription)."
    },
    "price_cents": {
      "type": "number",
      "description": "Integer cents (ADR-018, not decimal). Required when price_type is fixed/negotiable; null when poa/free/auction. AUD implicit (ADR-017)."
    },
    "auction_min_bid_cents": {
      "type": "number",
      "description": "Integer cents. Required when price_type=auction \u2014 the starting/minimum bid. AUD implicit."
    },
    "auction_reserve_cents": {
      "type": "number",
      "description": "Integer cents, nullable. Optional reserve price for auction listings \u2014 the seller is not obligated to sell below this. AUD implicit."
    },
    "auction_duration_days": {
      "type": "number",
      "description": "Integer 3/5/7. Required when price_type=auction \u2014 the auction duration in days. auction_ends_at is computed as published_at + this duration at publish time."
    },
    "auction_ends_at": {
      "type": "string",
      "format": "date-time",
      "description": "Set at publish time for auction listings = published_at + auction_duration_days. The auction is active until this time; after it, no further bids are accepted."
    },
    "current_bid_cents": {
      "type": "number",
      "description": "Denormalized current highest bid in cents. Null when no bids have been placed. Source of truth = Bid (is_winning=true)."
    },
    "current_bidder_id": {
      "type": "string",
      "description": "FK\u2192User, denormalized. The current highest bidder. Null when no bids have been placed."
    },
    "condition": {
      "type": "string",
      "enum": [
        "new",
        "used",
        "for_parts_or_repair"
      ],
      "default": "used",
      "description": "Three-value enum. Finer condition detail belongs in description."
    },
    "quantity": {
      "type": "number",
      "default": 1,
      "description": "Integer, default 1. Rarely more than 1."
    },
    "location_general": {
      "type": "string",
      "description": "Suburb/region only \u2014 privacy-conscious pattern consistent with User/Event/Business. No precise address."
    },
    "photo_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "ADR-045: listing photo URLs (uploaded via UploadFile). Capped at 10. Drives the Photos component of the Listing Quality Score."
    },
    "video_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "ADR-045: listing video URLs. Any non-empty array satisfies the Video component of the Listing Quality Score."
    },
    "primary_vehicle_id": {
      "type": "string",
      "description": "FK\u2192Vehicle. Required when category=vehicle AND listing_type=for_sale \u2014 must be owned by the poster (ownership validated via ReferenceResolverService + created_by_id check). Optional compatibility-context for other categories."
    },
    "compatible_models": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "civic",
          "integra",
          "accord",
          "crv",
          "s2000",
          "nsx",
          "other"
        ]
      },
      "default": [],
      "description": "ADR-043 compatibility filter. Bounded enum array. Only applies when category != vehicle; must be empty for vehicle listings (server-enforced CATEGORY_FIELD_MISMATCH)."
    },
    "compatible_chassis_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "eg",
          "ek",
          "dc2",
          "dc5",
          "ep3",
          "fn2",
          "cl7",
          "cl9",
          "fd2",
          "fk8",
          "fl5",
          "other"
        ]
      },
      "default": [],
      "description": "ADR-043 compatibility filter. Bounded enum array. Only applies when category != vehicle; must be empty for vehicle listings (server-enforced CATEGORY_FIELD_MISMATCH)."
    },
    "compatible_engine_families": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "d_series",
          "b_series",
          "k_series",
          "j_series",
          "f_series",
          "h_series",
          "other"
        ]
      },
      "default": [],
      "description": "ADR-043 compatibility filter. Bounded enum array. Only applies when category != vehicle; must be empty for vehicle listings (server-enforced CATEGORY_FIELD_MISMATCH)."
    },
    "compatible_year_from": {
      "type": "number",
      "description": "Compatibility year range start. Only applies when category != vehicle."
    },
    "compatible_year_to": {
      "type": "number",
      "description": "Compatibility year range end. Only applies when category != vehicle."
    },
    "brand": {
      "type": "string",
      "description": "ADR-042 generic category attribute. Applies to any category except 'vehicle' (must be null for vehicle). Free text, length-capped 100."
    },
    "oem_or_aftermarket": {
      "type": "string",
      "enum": [
        "oem",
        "aftermarket",
        "not_applicable"
      ],
      "description": "ADR-042 generic category attribute. Applies to any category except 'vehicle'. Required for engine/transmission/forced_induction/wheels_tyres/suspension/brakes/electronics/performance_part; optional otherwise. Must be null for vehicle."
    },
    "shipping_available": {
      "type": "boolean",
      "default": false,
      "description": "ADR-042 generic category attribute. Applies to any category except 'vehicle'. Defaults false."
    },
    "pickup_available": {
      "type": "boolean",
      "default": true,
      "description": "ADR-042 generic category attribute. Applies to any category except 'vehicle'. Defaults true."
    },
    "shipping_cost_cents": {
      "type": "number",
      "description": "ADR-042 generic category attribute. Integer cents. Required (non-null) when shipping_available=true; must be null when shipping_available=false (0 = free shipping). Applies to any category except 'vehicle'."
    },
    "wheel_diameter_inches": {
      "type": "number",
      "description": "ADR-042 wheels_tyres group. Integer 10\u201324. Applies only when category=wheels_tyres; must be null for every other category."
    },
    "wheel_width_inches": {
      "type": "number",
      "description": "ADR-042 wheels_tyres group. Decimal 3.0\u201315.0. Applies only when category=wheels_tyres."
    },
    "wheel_offset_mm": {
      "type": "number",
      "description": "ADR-042 wheels_tyres group. Integer -50 to 80. Applies only when category=wheels_tyres."
    },
    "wheel_pcd": {
      "type": "string",
      "description": "ADR-042 wheels_tyres group. Free-text PCD notation (e.g. '5x114.3'). Applies only when category=wheels_tyres."
    },
    "wheel_quantity": {
      "type": "number",
      "description": "ADR-042 wheels_tyres group. Integer 1\u20135. Applies only when category=wheels_tyres."
    },
    "tyres_included": {
      "type": "boolean",
      "default": false,
      "description": "ADR-042 wheels_tyres group. Applies only when category=wheels_tyres."
    },
    "tyre_tread_percentage": {
      "type": "number",
      "description": "ADR-042 wheels_tyres group. Integer 0\u2013100. Required when tyres_included=true; must be null when tyres_included is not true. Applies only when category=wheels_tyres."
    },
    "component_kilometres": {
      "type": "number",
      "description": "ADR-042 drivetrain group. Integer >=0, nullable (unknown history valid). Applies only when category is engine/transmission/forced_induction."
    },
    "tested_before_listing": {
      "type": "string",
      "enum": [
        "compression_tested",
        "leak_down_tested",
        "running_when_removed",
        "untested"
      ],
      "description": "ADR-042 drivetrain group. Applies only when category is engine/transmission/forced_induction."
    },
    "warranty_included": {
      "type": "boolean",
      "default": false,
      "description": "ADR-042 drivetrain group. Defaults false. Applies only when category is engine/transmission/forced_induction."
    },
    "lock_status": {
      "type": "string",
      "enum": [
        "locked",
        "unlocked",
        "not_applicable"
      ],
      "description": "ADR-042 electronics group. Applies only when category=electronics."
    },
    "tuned": {
      "type": "boolean",
      "default": false,
      "description": "ADR-042 electronics group. Defaults false. Applies only when category=electronics."
    },
    "additional_specifications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "label",
          "value"
        ]
      },
      "default": [],
      "description": "ADR-045 \u00a71: bounded, display-only supplementary label/value pairs. Max 10 entries; label \u2264 40 chars; value \u2264 100 chars; both required if an entry exists. Never searched or filtered. Rendered on Listing Detail below the structured fields."
    },
    "imported_from_connection_id": {
      "type": "string",
      "description": "ADR-046 Phase 1: nullable FK\u2192BusinessStoreConnection. Traceability ONLY \u2014 set solely by the internal MarketplaceService import-approval path (Section 8), which derives the poster server-side from the connection's business owner. NEVER read by search, filtering, permissions, or any manual listing-creation flow. Null for all manually-created listings. Additive field \u2014 existing flows are completely unaffected."
    },
    "business_id": {
      "type": "string",
      "description": "Nullable FK\u2192Business. Set when a listing belongs to a business storefront (currently by the import-approval path, taken from the connection's business). Unlike imported_from_connection_id, which is traceability only, this field IS read by search and filtering \u2014 it is what powers business storefront pages. Null for listings posted by individual members, which keeps member listings out of every storefront by default."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_review",
        "active",
        "reserved",
        "completed",
        "expired",
        "removed_by_poster",
        "removed_by_moderation"
      ],
      "default": "draft",
      "description": "Lifecycle: draft \u2192 pending_review/active \u2192 reserved \u2192 completed/expired \u2192 removed_by_poster/removed_by_moderation. 'completed' is the terminal SUCCESS state (ADR-026). completed + removed_by_moderation + removed_by_poster are terminal \u2014 no transition out."
    },
    "view_count": {
      "type": "number",
      "default": 0,
      "description": "Best-effort atomic increment, no backing log table (ADR-023 \u2014 explicit exception to the Denormalized Counter Rule)."
    },
    "conversation_count": {
      "type": "number",
      "default": 0,
      "description": "Denormalized count of conversations on this listing. Source of truth = MarketplaceConversation."
    },
    "published_at": {
      "type": "string",
      "format": "date-time",
      "description": "Set once, when status first reaches active \u2014 never overwritten by renewal."
    },
    "last_renewed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Enforces the 24-hour renewal rate limit (ADR-025)."
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Recalculated as (last_renewed_at ?? published_at) + 30 days on publish or renewal."
    }
  },
  "required": [
    "poster_id",
    "listing_type",
    "category",
    "title",
    "price_type",
    "condition",
    "quantity",
    "status"
  ]
}