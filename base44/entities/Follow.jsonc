{
  "name": "Follow",
  "type": "object",
  "properties": {
    "follower_id": {
      "type": "string",
      "description": "FK\u2192User. The follower (mirrors created_by_id; explicit for the uniqueness key)."
    },
    "target_type": {
      "type": "string",
      "enum": [
        "user",
        "vehicle",
        "business"
      ],
      "description": "Polymorphic follow target. Validated against a subset of ReferenceTypes (user, vehicle, business)."
    },
    "target_id": {
      "type": "string",
      "description": "FK\u2192User/Vehicle/Business depending on target_type."
    }
  },
  "required": [
    "follower_id",
    "target_type",
    "target_id"
  ]
}