{
  "name": "ModerationAction",
  "type": "object",
  "properties": {
    "moderation_case_id": {
      "type": "string",
      "description": "FK\u2192ModerationCase."
    },
    "action_type": {
      "type": "string",
      "enum": [
        "warning",
        "content_removed",
        "listing_removed",
        "account_restricted",
        "account_suspended",
        "account_banned",
        "no_action",
        "content_restored",
        "other"
      ],
      "description": "ModerationActionType registry. AI may NEVER create a row here \u2014 enforced structurally, not just by convention. Append-only: no update or delete path exists, ever."
    },
    "target_type": {
      "type": "string",
      "description": "What was actually acted upon \u2014 usually the case's own target, but may be a specific piece of content within a broader case."
    },
    "target_id": {
      "type": "string"
    },
    "actor": {
      "type": "string",
      "description": "system | moderator:<id> | admin:<id> \u2014 same pattern as TrustScoreEvent.actor. `system` means a human pre-approved this exact automated rule; never an AI live judgment call."
    },
    "reason": {
      "type": "string",
      "description": "Human-readable reason. Required."
    },
    "appeal_status": {
      "type": "string",
      "enum": [
        "none",
        "requested",
        "under_review",
        "upheld",
        "overturned"
      ],
      "default": "none",
      "description": "Appeal lifecycle: none \u2192 requested \u2192 under_review \u2192 upheld/overturned. A reversal is always a NEW ModerationAction row, never an edit to the original."
    },
    "appealed_at": {
      "type": "string",
      "format": "date-time"
    },
    "appeal_resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "appeal_resolved_by": {
      "type": "string",
      "description": "FK\u2192User (Admin). Set when an Admin resolves the appeal. Appeals are reviewed at a higher bar than the original action."
    }
  },
  "required": [
    "moderation_case_id",
    "action_type",
    "actor",
    "reason"
  ]
}