{
  "name": "MarketplaceMessage",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string",
      "description": "FK\u2192MarketplaceConversation."
    },
    "sender_id": {
      "type": "string",
      "description": "FK\u2192User. The sender (mirrors created_by_id; explicit). Either the conversation poster or initiator."
    },
    "body": {
      "type": "string",
      "description": "Message body. Text-only \u2014 no editing, no attachments. Required, capped at exactly 4,000 characters."
    },
    "status": {
      "type": "string",
      "enum": [
        "sent",
        "removed_by_sender",
        "removed_by_moderation"
      ],
      "default": "sent",
      "description": "sent \u2192 removed_by_sender (via removeOwnMessage, by the sender) or removed_by_moderation (via the content-moderation delegate, by Mod/Admin). No edit path exists. removed_by_sender is a soft-delete \u2014 the body is retained for moderator access under an active Report. Content is always retained."
    }
  },
  "required": [
    "conversation_id",
    "sender_id",
    "body",
    "status"
  ]
}