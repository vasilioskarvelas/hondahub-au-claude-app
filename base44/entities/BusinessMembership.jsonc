{
  "name": "BusinessMembership",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string",
      "description": "FK\u2192Business."
    },
    "user_id": {
      "type": "string",
      "description": "FK\u2192User. Mirrors created_by_id; explicit for the uniqueness key. Unique on (business_id, user_id)."
    },
    "role": {
      "type": "string",
      "enum": [
        "owner",
        "staff"
      ],
      "description": "Business-scoped roles, DISTINCT from platform AccountTier. Exactly one owner per Business at all times (service-enforced). Staff hold manager-level (BizMgr) permissions: may respond to reviews and create business-connected events; only the owner (BizOwn) manages members / transfers ownership."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "removed"
      ],
      "default": "active",
      "description": "active \u2192 removed on leave/kick. Unique on (business_id, user_id)."
    }
  },
  "required": [
    "business_id",
    "user_id",
    "role",
    "status"
  ]
}