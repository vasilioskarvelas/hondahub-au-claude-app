{
  "name": "Maintenance Due Reminder",
  "description": "Daily 08:00: reads MaintenanceRecord.next_service_date / next_service_odometer_km directly (no stored reminder field) and emails each vehicle owner a digest of due maintenance. Idempotent \u2014 gated by 'already ran today' via the JobStatus run log.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * *",
      "one_time_date": null,
      "timezone": "Australia/Melbourne",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "maintenance_due_reminder",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_reminder": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "reconcile",
            "args": {
              "action": "maintenance_due_reminder"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Maintenance-due reminder",
            "description": "reads next_service_* directly"
          }
        }
      }
    ]
  }
}